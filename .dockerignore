# Keep Docker build context small and secret-free

# Secrets & environment
.env
*.env
config/*.env*
config/config.paperless.yaml

# Runtime artifacts
data/
*.db
*.sqlite
*.sqlite3
*.log

# Documentation & non-build assets
docs/
mockups/
examples/
dashboard/
_category_.json

# Tests
tests/

# Version control
.git/
.gitignore

# Python artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# OS junk
.DS_Store
Thumbs.db

# Docker files (not needed in build context)
docker-compose.yml
docker-compose.*.yml
.dockerignore
Dockerfile

# Paperless-NGX connection
PAPERLESS_URL=http://paperless:8000
# Browser-reachable Paperless origin used for Document Views launch links
PAPERLESS_BROWSER_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=your_api_token_here
# Optional grouped launcher allowlist. Mount this file into the container.
# DOCUMENT_VIEWS_CONFIG=/app/config/document-views.yaml

# OpenAI-compatible LLM connection
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-development
LLM_MODEL=phi3:mini

# Database
DATABASE_URL=sqlite:///./data/actions.db

# Processing
CONFIDENCE_THRESHOLD=70
TAGS_TO_MONITOR=Inbox

# Safety — set WRITE_TO_PAPERLESS=false to run in read-only mode
# (analyzes documents and stores results in DB, but never writes to Paperless)
WRITE_TO_PAPERLESS=true
REMOVE_SOURCE_TAG_ON_RESOLVE=true
RATE_LIMIT_DELAY=1.0
# Bearer token required by the versioned Mission Control payee-review contract.
OWL_MISSION_CONTROL_API_TOKEN=
# Opaque Tyrion connector identity allowed for payee-pattern synchronization.
OWL_TYRION_PAYEE_CONNECTOR_REF=
# Server-only bearer token shared by every OWL-to-Tyrion request.
OWL_TYRION_API_TOKEN=
# Active Tyrion Bill Matching v2 connector used by Check for payment.
OWL_TYRION_BILL_MATCHING_URL=http://tyrion:8000/api/connector/v1/bill-matches
OWL_TYRION_BILL_MATCHING_CONNECTOR_REF=tyrion-bill-matching-v2

# Paperless document delivery to Monarch through the fixed private Tyrion authority.
# Writes remain disabled until this gate is explicitly enabled.
OWL_MONARCH_DELIVERY_TYRION_AUTHORITY=http://tyrion-operations-ui:3000
# Stable secret (16+ characters) used only to HMAC local/document delivery identities.
OWL_MONARCH_DELIVERY_IDENTITY_SECRET=
OWL_MONARCH_DELIVERY_WRITE_ENABLED=false
# Optional existing Paperless tag applied only after authoritative acknowledgement.
OWL_MONARCH_DELIVERY_SENT_TAG=
OWL_MONARCH_DELIVERY_DEPLOYMENT_ID=default
